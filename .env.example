# Address the Orca client uses to reach this server (required).
# Same machine + published port:
ORCA_PAIRING_ADDRESS=127.0.0.1
# LAN example:
# ORCA_PAIRING_ADDRESS=192.168.1.50
# Tailscale example:
# ORCA_PAIRING_ADDRESS=100.64.1.20

# SSH bind and port on the host.
SSH_HOST_BIND=127.0.0.1
SSH_HOST_PORT=2222

# Optional Orca flags.
ORCA_JSON=0
ORCA_MOBILE_PAIRING=0
# Set to 1 if Chromium reports sandbox errors.
ORCA_NO_SANDBOX=0
