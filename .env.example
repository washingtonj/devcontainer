# Address the Orca client uses to reach this server (required).
# Same machine + published port:
ORCA_PAIRING_ADDRESS=127.0.0.1
# LAN example:
# ORCA_PAIRING_ADDRESS=192.168.1.50
# Tailscale example:
# ORCA_PAIRING_ADDRESS=100.64.1.20

# Orca port bind on the host (default: localhost only).
ORCA_HOST_BIND=127.0.0.1
# For other devices on LAN/Tailscale:
# ORCA_HOST_BIND=0.0.0.0

# SSH bind and port on the host.
SSH_HOST_BIND=0.0.0.0
SSH_HOST_PORT=2222

# Host directory mounted as /home/agent.
HOST_HOME=./home

# Optional AppImage pin.
# ORCA_APPIMAGE_URL=https://github.com/stablyai/orca/releases/download/vX.Y.Z/orca-linux.AppImage

# Optional Orca flags.
ORCA_JSON=0
ORCA_MOBILE_PAIRING=0
# Set to 1 if Chromium reports sandbox errors.
ORCA_NO_SANDBOX=0
