# Address the Orca client uses to reach this server. Defaults to HOST_BIND;
# set this only when the client reaches the server via a different address
# (e.g. Tailscale on a machine whose published ports bind to the LAN IP).
# ORCA_PAIRING_ADDRESS=192.168.1.50

# Host interface used as bind address for all published ports (SSH and Syncthing).
# Restricting this to 127.0.0.1 requires an SSH tunnel for external access
# (including the Syncthing GUI).
HOST_BIND=127.0.0.1
SSH_HOST_PORT=2222

# Optional Orca flags.
ORCA_JSON=0
ORCA_MOBILE_PAIRING=0
# Set to 1 if Chromium reports sandbox errors.
ORCA_NO_SANDBOX=0

# Syncthing GUI credentials. Set both to require authentication; applied at
# every container start (overriding anything set in the GUI).
SYNCTHING_USER=
SYNCTHING_PASSWORD=
